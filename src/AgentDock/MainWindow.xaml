<Window x:Class="AgentDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AgentDock"
        mc:Ignorable="d"
        Title="Agent Dock"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        Closing="MainWindow_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="4"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootLayer">

    <DockPanel x:Name="RootPanel" LastChildFill="True">

        <!-- Remote status strip. Docked before the filling child so it takes the bottom edge.
             Always visible while hosting or connected: the server's owner must be able to see
             that someone is attached and sever it in one click, and the client must be able to
             tell at a glance that it is driving another machine. -->
        <Border x:Name="RemoteStrip" DockPanel.Dock="Bottom"
                Background="{DynamicResource TitleBarBackground}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6"
                Visibility="Collapsed">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="RemoteStripGlyph" Text="&#xE968;"
                               FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TabButtonActiveBorderBrush}"
                               Margin="0,0,8,0" />
                    <TextBlock x:Name="RemoteStripText" VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TitleBarForeground}" />
                    <TextBlock x:Name="RemoteStripCode" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               Foreground="{DynamicResource TabButtonActiveBorderBrush}"
                               Margin="12,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RemoteStripAddressButton" Content="Copy address"
                            Margin="0,0,8,0" Padding="10,2" FontSize="11" Cursor="Hand"
                            ToolTip="Copy this machine's address:port for the Connect to Server dialog"
                            Click="RemoteCopyAddress_Click" />
                    <Button x:Name="RemoteStripCopyButton" Content="Copy code"
                            Margin="0,0,8,0" Padding="10,2" FontSize="11" Cursor="Hand"
                            Click="RemoteCopyCode_Click" />
                    <Button x:Name="RemoteStripKickButton" Content="Take back control"
                            Margin="0,0,8,0" Padding="10,2" FontSize="11" Cursor="Hand"
                            Click="KickClient_Click" />
                    <Button x:Name="RemoteStripStopButton" Content="Stop server"
                            Padding="10,2" FontSize="11" Cursor="Hand"
                            Click="StopServer_Click" />
                    <Button x:Name="RemoteStripDisconnectButton" Content="Disconnect"
                            Padding="10,2" FontSize="11" Cursor="Hand"
                            Visibility="Collapsed"
                            Click="DisconnectRemote_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Custom Title Bar ===== -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource TitleBarBackground}"
                Height="44">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Icon -->
                    <ColumnDefinition Width="Auto" /> <!-- Product name -->
                    <ColumnDefinition Width="Auto" /> <!-- Menu -->
                    <ColumnDefinition Width="Auto" /> <!-- Add button -->
                    <ColumnDefinition Width="*" />    <!-- Title (fills) -->
                    <ColumnDefinition Width="Auto" /> <!-- Usage indicator -->
                    <ColumnDefinition Width="Auto" /> <!-- Total cost -->
                    <ColumnDefinition Width="Auto" /> <!-- Minimize -->
                    <ColumnDefinition Width="Auto" /> <!-- Maximize -->
                    <ColumnDefinition Width="Auto" /> <!-- Close -->
                </Grid.ColumnDefinitions>

                <!-- App icon -->
                <Image Grid.Column="0"
                       Source="/Assets/agentdock.png"
                       Width="18" Height="18"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center"
                       Margin="10,0,6,0"
                       WindowChrome.IsHitTestVisibleInChrome="True" />

                <!-- Product name + version -->
                <TextBlock x:Name="ProductNameText" Grid.Column="1"
                           Text="Agent Dock"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleBarForeground}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <!-- Separator between product name and menu -->
                <Border Grid.Column="1"
                        Width="1" Height="18"
                        Background="{DynamicResource TabButtonBorderBrush}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="4,0,0,0" />

                <!-- Menu bar -->
                <Menu Grid.Column="2"
                      VerticalAlignment="Center"
                      Margin="4,0,0,0"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem x:Name="FileMenu" Header="_File">
                        <MenuItem Header="_Add Project Folder" InputGestureText="Ctrl+N" Click="AddProject_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource MenuIconForeground}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="_Open Workspace" Click="OpenWorkspace_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource MenuIconForeground}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Save Workspace" InputGestureText="Ctrl+S" Click="SaveWorkspace_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource MenuIconForeground}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <!-- Recent workspaces. The items are inserted at runtime immediately
                             after the header (see PopulateRecentWorkspacesMenu) — both the
                             separator and the header hide when there are none. Anything added
                             below must stay below the separator that follows, or it reads as
                             one of the recent files. -->
                        <Separator x:Name="RecentWorkspacesSeparator" Visibility="Collapsed" />
                        <MenuItem x:Name="RecentWorkspacesHeader" Header="Recent Workspaces"
                                  IsEnabled="False" Visibility="Collapsed" />
                        <Separator />
                        <MenuItem Header="_Remote">
                            <MenuItem x:Name="StartServerMenuItem" Header="_Enter Server Mode..."
                                      Click="StartServer_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource MenuIconForeground}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="StopServerMenuItem" Header="S_top Server"
                                      IsEnabled="False" Click="StopServer_Click" />
                            <MenuItem x:Name="RegenerateCodeMenuItem" Header="_Regenerate Pairing Code"
                                      IsEnabled="False" Click="RegenerateCode_Click" />
                            <MenuItem x:Name="KickClientMenuItem" Header="Take _Back Control"
                                      IsEnabled="False" Click="KickClient_Click" />
                            <Separator />
                            <MenuItem x:Name="ConnectRemoteMenuItem" Header="_Connect to Server..."
                                      Click="ConnectRemote_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE703;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource MenuIconForeground}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="DisconnectRemoteMenuItem" Header="_Disconnect"
                                      IsEnabled="False" Click="DisconnectRemote_Click" />
                        </MenuItem>
                        <Separator x:Name="ExitSeparator" />
                        <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource MenuIconForeground}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="S_ettings">
                        <MenuItem Header="_Workspace Settings..." Click="WorkspaceSettings_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource MenuIconForeground}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_App Settings..." Click="AppSettings_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource MenuIconForeground}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="_Claude Accounts..." Click="Accounts_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource MenuIconForeground}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="_Getting Started" Click="GettingStarted_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource MenuIconForeground}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Check _Prerequisites" Click="CheckPrerequisites_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource MenuIconForeground}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="_About Agent Dock" Click="About_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource MenuIconForeground}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <!-- Add project button -->
                <Button x:Name="AddProjectButton" Grid.Column="3"
                        Click="AddProject_Click"
                        ToolTip="Add Project Folder (Ctrl+N)"
                        Height="24"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0"
                        Padding="6,0"
                        Cursor="Hand"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AddButtonBorderBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource AddButtonForeground}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource TitleBarButtonHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="{DynamicResource AddButtonForeground}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Window title (fills remaining space, shows project name) -->
                <TextBlock x:Name="TitleBarText" Grid.Column="4"
                           Text=""
                           FontSize="12"
                           Foreground="{DynamicResource TitleBarForeground}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

                <!-- Remote-mode badge. In the title bar because it has to be visible from across
                     a room and from a glance at a maximised window: the status strip at the
                     bottom edge is exactly where someone returning to the machine won't look.
                     Clicking it leaves whichever mode is live. -->
                <Button x:Name="RemoteModeBadge" Grid.Column="4"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Height="22"
                        Margin="0,0,10,0"
                        Padding="9,0"
                        Cursor="Hand"
                        Click="ExitRemoteMode_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource RemoteBadgeBackground}"
                                    BorderBrush="{DynamicResource RemoteBadgeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush"
                                            Value="{DynamicResource RemoteBadgeForeground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE968;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource RemoteBadgeForeground}"
                                   Margin="0,0,6,0" />
                        <TextBlock x:Name="RemoteModeBadgeText"
                                   Text="SERVER MODE"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource RemoteBadgeForeground}" />
                    </StackPanel>
                </Button>

                <!-- Usage indicator (5-hour session — click for details) -->
                <Button x:Name="UsageButton" Grid.Column="5"
                        Click="UsageButton_Click"
                        ToolTip="Click for full Claude Code usage details"
                        Height="26"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Padding="8,2"
                        Cursor="Hand"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="3"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"
                                                              HorizontalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource TitleBarButtonHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock x:Name="UsageText"
                               Text="Session: —"
                               FontSize="11"
                               Foreground="{DynamicResource TitleBarForeground}" />
                </Button>

                <!-- Usage detail popup -->
                <Popup x:Name="UsagePopup"
                       PlacementTarget="{Binding ElementName=UsageButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource TitleBarBackground}"
                            BorderBrush="{DynamicResource TabButtonBorderBrush}"
                            BorderThickness="1"
                            Padding="14"
                            MinWidth="340">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Claude Code Usage"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleBarForeground}" />
                                <Button x:Name="UsageRefreshButton"
                                        Content="Refresh"
                                        HorizontalAlignment="Right"
                                        Padding="8,2"
                                        FontSize="10"
                                        Cursor="Hand"
                                        Click="UsageRefresh_Click" />
                            </Grid>
                            <StackPanel x:Name="UsageDetailPanel" />
                            <TextBlock x:Name="UsageFooterText"
                                       FontSize="10"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource TitleBarForeground}" />
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Total cost across all projects -->
                <TextBlock x:Name="TotalCostText" Grid.Column="6"
                           Text=""
                           FontSize="11"
                           Foreground="{DynamicResource TitleBarForeground}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <!-- Window buttons (right side) -->
                <Button Grid.Column="7"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Click="MinimizeButton_Click"
                        ToolTip="Minimize"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE921;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource TitleBarForeground}" />
                </Button>

                <Button x:Name="MaximizeButton" Grid.Column="8"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Click="MaximizeButton_Click"
                        ToolTip="Maximize"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock x:Name="MaximizeIcon"
                               Text="&#xE922;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource TitleBarForeground}" />
                </Button>

                <Button Grid.Column="9"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        Click="CloseButton_Click"
                        ToolTip="Close"
                        WindowChrome.IsHitTestVisibleInChrome="True" />

            </Grid>
        </Border>

        <!-- ===== Workspace area below title bar ===== -->
        <DockPanel x:Name="WorkspacePanel" LastChildFill="True">

            <!-- Meta tab strip (groups). Always the top-most strip in the workspace so
                 the accent rail it carries can frame everything below. Hidden until
                 2+ groups exist. -->
            <Border x:Name="MetaTabBorder" DockPanel.Dock="Top"
                    Background="{DynamicResource GroupBarBackground}"
                    Visibility="Collapsed">
                <Grid>
                    <!-- Accent rail along the strip's bottom edge. First child, so the tabs
                         draw over it: each tab repaints the rail across its own bottom edge
                         (see the tab template), except the active one, which leaves the gap
                         that makes it read as joined to the workspace it owns. -->
                    <Border x:Name="GroupBarAccentLine"
                            Height="1"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource TabButtonActiveBorderBrush}" />
                    <DockPanel LastChildFill="False">
                        <!-- Remote-mode pill. Declared before ActiveGroupHost so the DockPanel
                             gives it the outer right edge, putting it immediately beside the
                             Active tab: while hosting, that tab is the published set, and this
                             is the one click that hands the machine back. -->
                        <Border x:Name="ServerModePill"
                                DockPanel.Dock="Right"
                                Visibility="Collapsed"
                                VerticalAlignment="Bottom"
                                Margin="8,0,6,3"
                                Padding="8,3"
                                CornerRadius="3"
                                Background="{DynamicResource RemoteBadgeBackground}"
                                BorderBrush="{DynamicResource RemoteBadgeBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE968;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource RemoteBadgeForeground}"
                                           Margin="0,0,6,0" />
                                <TextBlock x:Name="ServerModePillText"
                                           Text="Server mode"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource RemoteBadgeForeground}"
                                           Margin="0,0,8,0" />
                                <Button x:Name="ServerModePillButton"
                                        Content="Stop"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Padding="8,1"
                                        Cursor="Hand"
                                        Click="ExitRemoteMode_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource RemoteBadgeForeground}"
                                                    BorderThickness="1"
                                                    CornerRadius="2"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  HorizontalAlignment="Center"
                                                                  TextBlock.Foreground="{DynamicResource RemoteBadgeForeground}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource MenuHighlightBackground}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic "Active Projects" group — docked far right, set apart
                             from the real groups. Populated in code; empty otherwise. -->
                        <ContentControl x:Name="ActiveGroupHost"
                                        DockPanel.Dock="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="24,0,4,0" />
                        <StackPanel x:Name="MetaTabPanel" Orientation="Horizontal"
                                    DockPanel.Dock="Left">
                            <!-- Meta tab elements are inserted here dynamically -->
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Everything below the group strip is boxed in by the same accent rail
                 (down the left, across the bottom, up the right) so the visible
                 workspace reads as belonging to the active group. Thickness is set in
                 code and is zero whenever the group strip is hidden. -->
            <Border x:Name="GroupFrameBorder"
                    BorderBrush="{DynamicResource TabButtonActiveBorderBrush}"
                    BorderThickness="0">
                <DockPanel x:Name="WorkspaceInnerPanel" LastChildFill="True">

            <!-- Project Toolbar -->
            <Border x:Name="ToolbarBorder" DockPanel.Dock="Top"
                    Background="{DynamicResource ToolbarBackground}"
                    BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <!-- Accent rail along the strip's content-facing edge, in the project
                         accent (a different colour from the group rail, so the nesting
                         reads). First child, so the tabs draw over it: each tab repaints
                         the rail across its own content-facing edge (see the tab template),
                         except the active one, which leaves the gap that makes it read as
                         joined to the content below. Geometry is set in code for the
                         current toolbar position. -->
                    <Border x:Name="ProjectBarAccentLine"
                            Height="1"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource ProjectTabActiveBorderBrush}" />
                    <!-- Project tab buttons are inserted here dynamically -->
                    <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal" />
                </Grid>
            </Border>

            <!-- The content area is boxed in by the project accent on the three sides the
                 tab strip doesn't cover, so the active project reads as owning everything
                 below its tab. Thickness is set in code and is zero whenever the project
                 tab strip is hidden. -->
            <Border x:Name="ProjectFrameBorder"
                    BorderBrush="{DynamicResource ProjectTabActiveBorderBrush}"
                    BorderThickness="0">

            <!-- Main Content Area -->
            <Grid x:Name="ContentArea" Background="{DynamicResource ContentBackground}">
                <StackPanel x:Name="EmptyStatePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image Source="/Assets/agentdock.png"
                           Width="192" Height="192"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20" />
                    <TextBlock Text="Open a project folder to get started"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               Foreground="{DynamicResource EmptyStateForeground}"
                               Margin="0,0,0,16" />

                    <!-- Action buttons row -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,0">
                        <Button Click="AddProject_Click"
                                Cursor="Hand"
                                Padding="16,8"
                                Background="{DynamicResource TabButtonActiveBackground}"
                                BorderBrush="{DynamicResource TabButtonActiveBorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource TabButtonForeground}">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource TitleBarButtonHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{DynamicResource TabButtonForeground}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="Add Project Folder"
                                           FontSize="13"
                                           Foreground="{DynamicResource TabButtonForeground}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="OpenWorkspace_Click"
                                Cursor="Hand"
                                Padding="16,8"
                                Margin="8,0,0,0"
                                Background="{DynamicResource TabButtonActiveBackground}"
                                BorderBrush="{DynamicResource TabButtonActiveBorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource TabButtonForeground}">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource TitleBarButtonHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{DynamicResource TabButtonForeground}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="Open Workspace"
                                           FontSize="13"
                                           Foreground="{DynamicResource TabButtonForeground}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Recent workspaces (populated dynamically) -->
                    <StackPanel x:Name="EmptyStateRecentPanel"
                                HorizontalAlignment="Center"
                                Margin="0,24,0,0"
                                Visibility="Collapsed">
                        <TextBlock Text="Recent Workspaces"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource EmptyStateForeground}"
                                   Margin="0,0,0,8" />
                        <StackPanel x:Name="EmptyStateRecentList" />
                    </StackPanel>
                </StackPanel>

                <ContentPresenter x:Name="ProjectContentHost"
                                  Visibility="Collapsed" />
            </Grid>
            </Border>

                </DockPanel>
            </Border>

        </DockPanel>
    </DockPanel>

    <!-- ===== Busy Overlay =====
         Sits above everything (including the title bar) so it both signals work in
         progress and swallows clicks while a workspace is being opened. Shown via
         ShowBusyOverlay() in code-behind; the spinner only animates because the
         open path yields to the dispatcher between projects. -->
    <Grid x:Name="BusyOverlay"
          Background="{DynamicResource BusyOverlayScrim}"
          Visibility="Collapsed"
          Opacity="0">
        <!-- Fixed width, and every line below the spinner has a reserved height, so the
             card never resizes as the project name / counter text changes underneath it. -->
        <Border Background="{DynamicResource HelpBackground}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="32,26"
                Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <Path x:Name="BusySpinner"
                      Width="34" Height="34"
                      Margin="0,0,0,16"
                      HorizontalAlignment="Center"
                      Data="M 17,3 A 14,14 0 1 1 3,17"
                      Stroke="{DynamicResource TabButtonActiveBorderBrush}"
                      StrokeThickness="3"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="BusySpinnerRotation" Angle="0" />
                    </Path.RenderTransform>
                </Path>
                <TextBlock x:Name="BusyTitleText"
                           Text="Opening workspace…"
                           Height="19"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource HelpForeground}" />
                <TextBlock x:Name="BusyCountText"
                           Height="16"
                           Margin="0,8,0,0"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="11"
                           Foreground="{DynamicResource EmptyStateForeground}" />
                <ProgressBar x:Name="BusyProgressBar"
                             Height="6"
                             Margin="0,6,0,0"
                             Minimum="0" Maximum="100"
                             Background="{DynamicResource HelpCardBackground}"
                             Foreground="{DynamicResource TabButtonActiveBorderBrush}"
                             BorderThickness="0" />
                <TextBlock x:Name="BusyDetailText"
                           Height="17"
                           Margin="0,8,0,0"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="12"
                           Foreground="{DynamicResource EmptyStateForeground}" />
            </StackPanel>
        </Border>
    </Grid>

    </Grid>

    <!-- Keyboard Shortcuts -->
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{x:Static local:MainWindow.AddProjectCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{x:Static local:MainWindow.SaveWorkspaceCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{x:Static local:MainWindow.CloseProjectCommand}" />
    </Window.InputBindings>
</Window>
